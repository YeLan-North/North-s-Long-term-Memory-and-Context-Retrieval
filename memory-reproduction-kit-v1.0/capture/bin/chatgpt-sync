#!/usr/bin/env python3
"""Keep a local, git-versioned copy of your ChatGPT conversations.

Subcommands:
  serve     Run the localhost listener the browser extension pushes to.
  import    Import an official ChatGPT data export (zip or unpacked folder).
  render    Re-render every stored conversation (after changing the format).
  status    Show the last sync and archive counts.

Raw conversation JSON in the data directory is the source of truth and is
committed to a local git repo there after each sync. Markdown (default) or Org
files are generated from it and can be rebuilt at any time with `render`.

Settings come from ~/.config/chatgpt-sync/config.json (or the file named by
CHATGPT_SYNC_CONFIG). All keys are optional:
  format      "markdown" (default) or "org" (Org needs pandoc)
  output_dir  where rendered files go (default: <data_dir>/<format>)
  data_dir    raw JSON and index (default: data/ next to bin/)
  state_dir   heartbeat and pause file (default: ~/.local/state/chatgpt-sync)
"""

from __future__ import annotations

import argparse
import datetime as dt
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import unicodedata
import zipfile
from concurrent.futures import ThreadPoolExecutor
from zoneinfo import ZoneInfo
import math
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# ----------------------------------------------------------------- config

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONFIG_PATH = os.environ.get("CHATGPT_SYNC_CONFIG") or os.path.expanduser(
    os.path.join(REPO, "config.json"))
FORMATS = {"markdown": ".md", "org": ".org"}
CONFIG_KEYS = {"format", "output_dir", "data_dir", "state_dir", "project_ids", "timezone"}
CAPTURE_VERSION = 2


def load_config(path: str) -> dict:
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as f:
        config = json.load(f)
    unknown = set(config) - CONFIG_KEYS
    if unknown:
        sys.exit(f"{path}: unknown setting(s) {sorted(unknown)}; known: {sorted(CONFIG_KEYS)}")
    if config.get("format", "markdown") not in FORMATS:
        sys.exit(f"{path}: format must be one of {sorted(FORMATS)}")
    projects = config.get("project_ids")
    if not isinstance(projects, list) or not projects or any(not isinstance(x, str) or not re.fullmatch(r"g-p-[a-zA-Z0-9-]+", x) for x in projects):
        raise ValueError("project_ids must be a nonempty explicit project whitelist")
    ZoneInfo(config.get("timezone", "America/Vancouver"))
    return config


CONFIG = load_config(CONFIG_PATH)
PROJECT_IDS = CONFIG.get("project_ids", [])
TIMEZONE = CONFIG.get("timezone", "America/Vancouver")
TZ = ZoneInfo(TIMEZONE)
FORMAT = CONFIG.get("format", "markdown")
DATA = os.path.expanduser(CONFIG.get("data_dir") or os.path.join(REPO, "data"))
OUTPUT = os.path.expanduser(CONFIG.get("output_dir") or os.path.join(DATA, FORMAT))
STATE_DIR = os.path.expanduser(CONFIG.get("state_dir") or os.path.join(REPO, "state"))
RAW = os.path.join(DATA, "raw")
INDEX = os.path.join(DATA, "index.json")
LAST_SYNC = os.path.join(STATE_DIR, "last-sync.json")
PAUSED = os.path.join(STATE_DIR, "paused")

PORT = 8765
# Fixed by the "key" in extension/manifest.json; only this extension may push.
EXTENSION_ORIGIN = "chrome-extension://peikpbjilajgjpmkipcbgkfamfpihhno"

LOCK = threading.Lock()


# ---------------------------------------------------------------- helpers

def to_epoch(value) -> float:
    """Normalize ChatGPT timestamps (epoch floats or ISO strings) to epoch."""
    if value is None:
        return 0.0
    if isinstance(value, bool):
        raise ValueError("boolean is not a timestamp")
    if isinstance(value, (int, float)):
        n = float(value)
        if not math.isfinite(n) or n < 0:
            raise ValueError("invalid timestamp")
        return n / 1000 if n > 100_000_000_000 else n
    s = str(value).replace("Z", "+00:00")
    if re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", s):
        return to_epoch(float(s))
    parsed = dt.datetime.fromisoformat(s)
    if parsed.tzinfo is None:
        raise ValueError("timestamp needs a timezone")
    return parsed.timestamp()


def org_ts(epoch: float) -> str:
    return dt.datetime.fromtimestamp(epoch, TZ).strftime("[%Y-%m-%d %a %H:%M]")


def iso_ts(epoch: float) -> str:
    return dt.datetime.fromtimestamp(epoch, TZ).isoformat(timespec="seconds")


def write_atomic(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def load_index() -> dict:
    if os.path.exists(INDEX):
        with open(INDEX, encoding="utf-8") as f:
            return json.load(f)
    return {}


def save_index(index: dict) -> None:
    write_atomic(INDEX, json.dumps(index, indent=1, sort_keys=True, ensure_ascii=False) + "\n")


def slugify(title: str) -> str:
    s = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode()
    s = re.sub(r"[^a-zA-Z0-9]+", "-", s).strip("-").lower()
    return s[:60].rstrip("-") or "untitled"


def conv_id(conv: dict) -> str:
    return conv.get("conversation_id") or conv["id"]


def require_pandoc() -> None:
    if FORMAT == "org" and not shutil.which("pandoc"):
        sys.exit("format \"org\" needs pandoc on PATH (https://pandoc.org/installing.html)")


# --------------------------------------------------------- message content

CITATION_MARK = re.compile(".*?", re.S)


def apply_content_references(text: str, metadata: dict) -> str:
    """Replace ChatGPT's private-use citation markers with readable text."""
    refs = metadata.get("content_references") or []
    for ref in sorted(refs, key=lambda r: -len(r.get("matched_text") or "")):
        matched = ref.get("matched_text")
        if not matched:
            continue
        replacement = ref.get("alt") or ""
        if not replacement and ref.get("items"):
            links = [f"[{i.get('title') or i.get('url')}]({i['url']})"
                     for i in ref["items"] if i.get("url")]
            replacement = " (" + "; ".join(links) + ")" if links else ""
        text = text.replace(matched, replacement)
    return CITATION_MARK.sub("", text)


def fence(body: str, lang: str = "") -> str:
    ticks = "````" if "```" in body else "```"
    return f"{ticks}{lang}\n{body}\n{ticks}"


def message_markdown(msg: dict) -> str | None:
    """Return the markdown for one message, or None to omit it."""
    content = msg.get("content") or {}
    ctype = content.get("content_type")
    meta = msg.get("metadata") or {}
    role = (msg.get("author") or {}).get("role")

    if ctype == "text":
        text = "\n\n".join(p for p in content.get("parts") or [] if isinstance(p, str))
        if role == "assistant":
            text = apply_content_references(text, meta)
        return text if text.strip() else None
    if ctype == "multimodal_text":
        out = []
        for p in content.get("parts") or []:
            if isinstance(p, str):
                out.append(p)
            elif isinstance(p, dict):
                pt = p.get("content_type")
                if pt == "audio_transcription":
                    out.append(p.get("text", ""))
                elif pt == "image_asset_pointer":
                    out.append(f"[image: {p.get('asset_pointer', '')}]")
                else:
                    out.append(f"[{pt}]")
        text = "\n\n".join(x for x in out if x)
        return text if text.strip() else None
    if ctype == "code":
        lang = content.get("language") or ""
        if lang == "unknown":
            lang = ""
        return fence(content.get("text", ""), lang)
    if ctype == "execution_output":
        return fence(content.get("text", ""))
    if ctype == "thoughts":
        lines = []
        for t in content.get("thoughts") or []:
            if t.get("summary"):
                lines.append(f"**{t['summary']}**")
            if t.get("content"):
                lines.append(t["content"])
        return "\n\n".join(lines) or None
    if ctype in ("reasoning_recap", "user_editable_context", "model_editable_context"):
        return None
    if ctype == "tether_quote":
        return f"> {content.get('text', '')}\n\n— [{content.get('title', '')}]({content.get('url', '')})"
    if ctype in ("tether_browsing_display", "system_error"):
        text = content.get("result") or content.get("text") or ""
        return fence(text) if text.strip() else None
    if ctype == "sonic_webpage":
        return f"[{content.get('title', '')}]({content.get('url', '')})"
    return f"[unrendered content type: {ctype}]"


def heading_for(msg: dict) -> tuple:
    """Return (group key, heading text) used to merge consecutive turns."""
    author = msg.get("author") or {}
    role = author.get("role")
    ctype = (msg.get("content") or {}).get("content_type")
    if role == "user":
        return ("user", "User")
    if role == "tool":
        return ("tool", f"Tool output ({author.get('name') or 'tool'})")
    if ctype == "thoughts":
        return ("thoughts", "Reasoning")
    recipient = msg.get("recipient") or "all"
    if recipient != "all":
        return ("call", f"Tool call → {recipient}")
    return ("assistant", "ChatGPT")


def current_path(conv: dict) -> list:
    mapping = conv.get("mapping") or {}
    node_id = conv.get("current_node")
    path = []
    seen = set()
    while node_id and node_id in mapping:
        if node_id in seen:
            raise ValueError("cyclic conversation tree")
        seen.add(node_id)
        node = mapping[node_id]
        if node.get("message"):
            path.append(node["message"])
        node_id = node.get("parent")
    return list(reversed(path))


def visible_blocks(conv: dict) -> list:
    """Return (group key, heading, epoch, markdown) for the rendered branch."""
    blocks = []
    for msg in current_path(conv):
        role = (msg.get("author") or {}).get("role")
        meta = msg.get("metadata") or {}
        if role == "system" or meta.get("is_visually_hidden_from_conversation"):
            continue
        md = message_markdown(msg)
        if md is None:
            continue
        key, head = heading_for(msg)
        blocks.append((key, head, msg.get("create_time"), md))
    return blocks


# ---------------------------------------------------------- markdown output

FENCE_OPEN = re.compile(r"^\s{0,3}(`{3,}|~{3,})")
ATX_HEADING = re.compile(r"^(#{1,6})(\s)")


def shift_headings(markdown: str, by: int) -> str:
    """Demote ATX headings outside code fences so they nest under turns."""
    out, fence_marker = [], None
    for line in markdown.split("\n"):
        m = FENCE_OPEN.match(line)
        if m:
            marker = m.group(1)
            if fence_marker is None:
                fence_marker = marker
            elif marker[0] == fence_marker[0] and len(marker) >= len(fence_marker):
                fence_marker = None
        elif fence_marker is None:
            line = ATX_HEADING.sub(lambda h: "#" * min(6, len(h.group(1)) + by) + h.group(2), line)
        out.append(line)
    return "\n".join(out)


def markdown_literal(text: str) -> str:
    """User turns are shown as typed; keep a leading # from becoming a heading."""
    return re.sub(r"^(\s{0,3})#", r"\1\\#", text, flags=re.M)


def render_markdown(conv: dict, entry: dict) -> str:
    cid = conv_id(conv)
    front = {
        "title": entry["title"],
        "chatgpt_id": cid,
        "url": f"https://chatgpt.com/c/{cid}",
        "created": iso_ts(to_epoch(conv.get("create_time"))),
        "updated": iso_ts(entry["update_time"]),
        "model": conv.get("default_model_slug"),
        "archived": entry.get("is_archived") or None,
        "starred": entry.get("is_starred") or None,
        "gizmo": conv.get("gizmo_id"),
    }
    out = ["---"]
    out += [f"{k}: {json.dumps(v, ensure_ascii=False)}" for k, v in front.items() if v is not None]
    out += ["---", "", f"# {entry['title']}", ""]
    for key, head, created, md in visible_blocks(conv):
        stamp = f" · {dt.datetime.fromtimestamp(to_epoch(created), TZ).isoformat()}" if created else " · 时间缺失"
        out += [f"## {head}{stamp}", "", markdown_literal(md) if key == "user" else shift_headings(md, 2), ""]
    return "\n".join(out).rstrip("\n") + "\n"


# --------------------------------------------------------------- org output

PANDOC_FROM = "markdown-smart-auto_identifiers+tex_math_single_backslash"
SEPARATOR = "CHATGPTSYNCSEPARATOR7F3A"


def pandoc(markdown: str) -> str:
    out = subprocess.run(
        ["pandoc", "-f", PANDOC_FROM, "-t", "org", "--wrap=preserve",
         "--shift-heading-level-by=1"],
        input=markdown, capture_output=True, text=True, check=True)
    return out.stdout


def md_to_org_many(chunks: list) -> list:
    """Convert markdown chunks to Org in one pandoc call.

    Chunks are joined with a separator paragraph. If a chunk leaves a code
    fence open, the separator gets swallowed and the split count is wrong;
    then each chunk is converted on its own, which is slower but exact.
    """
    if not chunks:
        return []
    joined = f"\n\n{SEPARATOR}\n\n".join(chunks)
    parts = re.split(rf"^{SEPARATOR}$", pandoc(joined), flags=re.M)
    if len(parts) == len(chunks):
        return [p.strip("\n") for p in parts]
    return [pandoc(c).strip("\n") for c in chunks]


def org_literal(text: str) -> str:
    """User turns are shown verbatim, as ChatGPT displays them."""
    escaped = re.sub(r"^(\s*)([*]|#\+|,[*]|,#\+)", r"\1,\2", text, flags=re.M)
    return f"#+begin_example\n{escaped}\n#+end_example"


def render_org(conv: dict, entry: dict) -> str:
    blocks = visible_blocks(conv)
    converted = iter(md_to_org_many([b[3] for b in blocks if b[0] != "user"]))
    bodies = [org_literal(b[3]) if b[0] == "user" else next(converted) for b in blocks]
    cid = conv_id(conv)
    out = [":PROPERTIES:"]
    # An "org_id" set by hand in index.json keeps Org ID links to this chat
    # working across re-renders.
    if entry.get("org_id"):
        out.append(f":ID:       {entry['org_id']}")
    out += [
        f":CHATGPT_ID: {cid}",
        f":CHATGPT_URL: https://chatgpt.com/c/{cid}",
        f":CREATED: {org_ts(to_epoch(conv.get('create_time')))}",
        f":UPDATED: {org_ts(entry['update_time'])}",
    ]
    if conv.get("default_model_slug"):
        out.append(f":MODEL: {conv['default_model_slug']}")
    if entry.get("is_archived"):
        out.append(":ARCHIVED: t")
    if entry.get("is_starred"):
        out.append(":STARRED: t")
    if conv.get("gizmo_id"):
        out.append(f":GIZMO: {conv['gizmo_id']}")
    out += [":END:", f"#+title: {entry['title']}", ""]

    prev_key = None
    for (key, head, created, _), body in zip(blocks, bodies):
        if key != prev_key:
            stamp = f" {org_ts(to_epoch(created))}" if created else ""
            out += [f"* {head}{stamp}", ""]
            prev_key = key
        out += [body, ""]
    return "\n".join(out).rstrip("\n") + "\n"


RENDERERS = {"markdown": render_markdown, "org": render_org}


def render(conv: dict, entry: dict) -> str:
    return RENDERERS[FORMAT](conv, entry)


def output_relpath(conv: dict, title: str) -> str:
    created = dt.datetime.fromtimestamp(to_epoch(conv.get("create_time")), TZ)
    cid = conv_id(conv)
    return os.path.join(created.strftime("%Y"),
                        # The ID's first 8 hex digits are its creation second,
                        # so add its random tail to keep same-second chats apart.
                        f"{created:%Y-%m-%d}--{slugify(title)}--{cid[:8]}{cid[-4:]}"
                        + FORMATS[FORMAT])


# ------------------------------------------------------------------ store

def ensure_data_repo() -> None:
    """Create the data directory as a local git repo on first use."""
    os.makedirs(RAW, exist_ok=True)
    if not os.path.isdir(os.path.join(DATA, ".git")):
        subprocess.run(["git", "init", "-q", DATA], check=True)
    ignore = os.path.join(DATA, ".gitignore")
    if not os.path.exists(ignore):
        # Rendered output is regenerated from raw/, so only raw/ is versioned.
        # No trailing slash: the output folder may be a symlink.
        write_atomic(ignore, "".join(f"/{f}\n" for f in FORMATS))


def store(conv: dict, meta: dict | None, index: dict, force: bool = False) -> bool:
    """Save one conversation's raw JSON and rendered file. Return True if written."""
    cid = conv_id(conv)
    uuid.UUID(cid)
    if str(uuid.UUID(cid)) != cid.lower():
        raise ValueError("invalid conversation id")
    meta = meta or {}
    project = meta.get("_capture_project_id") or conv.get("gizmo_id")
    if project not in PROJECT_IDS:
        raise ValueError("conversation is outside project whitelist")
    if conv.get("gizmo_id") and conv["gizmo_id"] != project:
        raise ValueError("project mismatch")
    mapping = conv.get("mapping")
    if not isinstance(mapping, dict) or not mapping or conv.get("current_node") not in mapping:
        raise ValueError("incomplete conversation tree")
    current_path(conv)
    ordered_nodes(conv)
    detail_update = to_epoch(conv.get("update_time"))
    if detail_update <= 0 or detail_update + .001 < to_epoch(meta.get("update_time")):
        raise ValueError("detail snapshot is older than listing; retry required")
    update = max(to_epoch(conv.get("update_time")), to_epoch(meta.get("update_time")))
    old = index.get(cid)
    if old and old.get("capture_version") == CAPTURE_VERSION and old["update_time"] >= update and not force:
        return False

    def flag(name):
        # Freshest source first: the listing sent with this sync, then the
        # index (kept current by update_flags), then the raw JSON, whose copy
        # dates from the last fetch and misses archive/star-only changes.
        if name in meta:
            return bool(meta[name])
        if old and name in old:
            return bool(old[name])
        return bool(conv.get(name, False))

    title = conv.get("title") or meta.get("title") or "Untitled"
    entry = {
        "title": title,
        "create_time": to_epoch(conv.get("create_time")),
        "update_time": update,
        "is_archived": flag("is_archived"),
        "is_starred": flag("is_starred"),
        "gizmo_id": project,
        "capture_version": CAPTURE_VERSION,
        "file": output_relpath(conv, title),
    }
    if old and old.get("org_id"):
        entry["org_id"] = old["org_id"]
    write_atomic(os.path.join(RAW, f"{cid}.json"),
                 json.dumps(conv, indent=1, sort_keys=True, ensure_ascii=False) + "\n")
    write_atomic(os.path.join(OUTPUT, entry["file"]), render(conv, entry))
    if old and old.get("file") and old["file"] != entry["file"]:
        stale = os.path.join(OUTPUT, old["file"])
        if os.path.exists(stale):
            os.remove(stale)  # renamed chat; raw/ history keeps the old version
    index[cid] = entry
    return True


def update_flags(listing: list, index: dict) -> list:
    """Apply archived/starred changes that don't bump update_time."""
    changed = []
    for item in listing:
        entry = index.get(item.get("id"))
        if not entry:
            continue
        flags = {k: bool(item[k]) for k in ("is_archived", "is_starred") if k in item}
        if any(entry.get(k) != v for k, v in flags.items()):
            entry.update(flags)
            changed.append(item["id"])
    for cid in changed:
        with open(os.path.join(RAW, f"{cid}.json"), encoding="utf-8") as f:
            conv = json.load(f)
        write_atomic(os.path.join(OUTPUT, index[cid]["file"]), render(conv, index[cid]))
    return changed


def git_commit(message: str) -> str | None:
    paths = ["raw", "index.json"]
    subprocess.run(["git", "-C", DATA, "add", "-A", *paths], check=True)
    staged = subprocess.run(["git", "-C", DATA, "diff", "--cached", "--quiet"])
    if staged.returncode == 0:
        return None
    # The pathspec keeps any other staged work out of sync commits.
    subprocess.run(["git", "-C", DATA, "-c", "user.name=Local Chat Archive", "-c", "user.email=local-archive@localhost", "commit", "-q", "-m", message, "--", *paths], check=True)
    return subprocess.run(["git", "-C", DATA, "rev-parse", "--short", "HEAD"],
                          capture_output=True, text=True, check=True).stdout.strip()


# ----------------------------------------------------------------- server

class Handler(BaseHTTPRequestHandler):
    server_version = "chatgpt-sync"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (dt.datetime.now().isoformat(timespec="seconds"), fmt % args))

    def _reply(self, code: int, payload: dict) -> None:
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self) -> bool:
        if os.path.exists(PAUSED):
            self._reply(503, {"error": f"paused: remove {PAUSED} to resume"})
            return False
        origin = self.headers.get("Origin")
        if origin == EXTENSION_ORIGIN:
            return True
        # Chrome omits Origin on the extension's GETs. Allowing that is safe:
        # a web page's Origin-less request (no-cors) gets an opaque response
        # it can't read, and GET changes nothing.
        if origin is None and self.command == "GET":
            return True
        self.log_message("rejected %s %s from origin %r", self.command, self.path, origin)
        self._reply(403, {"error": "forbidden origin"})
        return False

    def do_GET(self):
        if self.path == "/health":
            return self._reply(200, {"ok": True})
        if not self._authorized():
            return
        if self.path == "/config":
            return self._reply(200, {"project_ids": PROJECT_IDS, "timezone": TIMEZONE, "capture_version": CAPTURE_VERSION})
        if self.path == "/state":
            with LOCK:
                index = load_index()
            return self._reply(200, {"ids": {k: v["update_time"] for k, v in index.items() if v.get("capture_version") == CAPTURE_VERSION and v.get("gizmo_id") in PROJECT_IDS}})
        self._reply(404, {"error": "not found"})

    def do_POST(self):
        if not self._authorized():
            return
        length = int(self.headers.get("Content-Length") or 0)
        payload = json.loads(self.rfile.read(length) or b"{}")
        try:
            if self.path == "/conversations":
                with LOCK:
                    index = load_index()
                    written, accepted, failures = [], [], []
                    for it in payload["items"]:
                        cid = (it.get("meta") or {}).get("id")
                        try:
                            conv = it["conversation"]
                            if cid != conv_id(conv):
                                raise ValueError("listing/detail ID mismatch")
                            if store(conv, it.get("meta"), index):
                                written.append(cid)
                            accepted.append(cid)
                        except Exception as exc:
                            failures.append({"id": cid, "stage": "store", "error": str(exc)})
                    save_index(index)
                return self._reply(200, {"written": len(written), "accepted_ids": accepted, "errors": failures})
            if self.path == "/sync-done":
                with LOCK:
                    index = load_index()
                    flagged = update_flags(payload.get("listing") or [], index)
                    save_index(index)
                    s = payload.get("summary") or {}
                    commit = None
                    try:
                        commit = git_commit(f"sync: {s.get('fetched', 0)} fetched, {len(flagged)} flag changes")
                    except Exception as exc:
                        payload.setdefault("errors", []).append({"stage": "git_commit", "error": str(exc)})
                        payload["complete"] = False
                record = {"status": "complete" if payload.get("complete") is True and not payload.get("errors") else "partial",
                          "project_ids": PROJECT_IDS, "timezone": TIMEZONE,
                          "at": dt.datetime.now(TZ).isoformat(timespec="seconds"),
                          "summary": s, "flag_changes": len(flagged),
                          "commit": commit, "errors": payload.get("errors") or []}
                stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
                write_atomic(os.path.join(STATE_DIR, "runs", stamp + ".json"), json.dumps(record, indent=1) + "\n")
                write_atomic(LAST_SYNC, json.dumps(record, indent=1) + "\n")
                return self._reply(200, {"commit": commit, "complete": record["status"] == "complete", "errors": record["errors"]})
        except Exception as e:  # report to the extension, which shows a badge
            self.log_message("error on %s: %r", self.path, e)
            return self._reply(500, {"error": repr(e)})
        self._reply(404, {"error": "not found"})


def make_server(port: int) -> ThreadingHTTPServer:
    require_pandoc()
    ensure_data_repo()
    os.makedirs(STATE_DIR, exist_ok=True)
    return ThreadingHTTPServer(("127.0.0.1", port), Handler)


def cmd_serve(args) -> None:
    httpd = make_server(args.port)
    print(f"listening on 127.0.0.1:{httpd.server_port}; writing {FORMAT} to {OUTPUT}",
          file=sys.stderr, flush=True)
    httpd.serve_forever()


# ------------------------------------------------------------ import/render

def read_export(path: str) -> list:
    convs = []
    if zipfile.is_zipfile(path):
        with zipfile.ZipFile(path) as z:
            for name in sorted(z.namelist()):
                if re.fullmatch(r"(.*/)?conversations(-\d+)?\.json", name):
                    convs += json.loads(z.read(name))
    else:
        for name in sorted(glob.glob(os.path.join(path, "conversations*.json"))):
            with open(name, encoding="utf-8") as f:
                convs += json.load(f)
    if not convs:
        sys.exit(f"no conversations*.json found in {path}")
    return convs


def parallel_store(convs: list, index: dict, force: bool) -> int:
    # Rendering dominates; index updates happen on the main thread afterwards.
    def work(conv):
        local = {conv_id(conv): index[conv_id(conv)]} if conv_id(conv) in index else {}
        return local if store(conv, None, local, force) else None
    n = 0
    with ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as pool:
        for result in pool.map(work, convs):
            if result:
                index.update(result)
                n += 1
    return n


def cmd_import(args) -> None:
    require_pandoc()
    ensure_data_repo()
    convs = read_export(args.path)
    with LOCK:
        index = load_index()
        n = parallel_store(convs, index, force=False)
        save_index(index)
        commit = git_commit(f"import: {n} of {len(convs)} conversations from official export")
    print(f"{len(convs)} in export, {n} new or newer, commit {commit}")


def cmd_render(args) -> None:
    require_pandoc()
    with LOCK:
        index = load_index()
        convs = []
        for cid in index:
            with open(os.path.join(RAW, f"{cid}.json"), encoding="utf-8") as f:
                convs.append(json.load(f))
        n = parallel_store(convs, index, force=True)
        save_index(index)
    print(f"re-rendered {n} conversations as {FORMAT} in {OUTPUT}")


def cmd_status(args) -> None:
    index = load_index()
    print(f"{len(index)} conversations ({sum(e['is_archived'] for e in index.values())} archived)")
    print(f"format {FORMAT}, data {DATA}, output {OUTPUT}")
    if os.path.exists(LAST_SYNC):
        with open(LAST_SYNC) as f:
            print("last sync:", f.read().strip())
    else:
        print("no sync recorded yet")



# ------------------------------------------------------ daily raw-source export

def ordered_nodes(conv):
    mapping = conv["mapping"]
    children = {k: [] for k in mapping}
    roots = []
    for key, node in mapping.items():
        parent = node.get("parent")
        if parent is None:
            roots.append(key)
        elif parent not in mapping:
            raise ValueError("missing parent in conversation tree")
        else:
            children[parent].append(key)
    seen, ordered = set(), []
    stack = list(reversed(roots))
    while stack:
        key = stack.pop()
        if key in seen:
            raise ValueError("cyclic conversation tree")
        seen.add(key)
        ordered.append((key, mapping[key]))
        stack.extend(reversed(children[key]))
    if len(seen) != len(mapping):
        raise ValueError("disconnected/cyclic conversation tree")
    return ordered


def daily_rows(conv, project_id, date):
    start = dt.datetime.combine(date, dt.time.min, TZ).timestamp() if date else float("-inf")
    end = dt.datetime.combine(date + dt.timedelta(days=1), dt.time.min, TZ).timestamp() if date else float("inf")
    active, key = set(), conv.get("current_node")
    while key in conv["mapping"]:
        if key in active:
            raise ValueError("cyclic current path")
        active.add(key)
        key = conv["mapping"][key].get("parent")
    rows, undated = [], []
    for ordinal, (node_id, node) in enumerate(ordered_nodes(conv)):
        message = node.get("message")
        if not message:
            continue
        role = (message.get("author") or {}).get("role")
        hidden = (message.get("metadata") or {}).get("is_visually_hidden_from_conversation", False)
        if role not in ("user", "assistant") or hidden:
            continue
        # The raw snapshot retains tool/runtime records; the daily reading view
        # includes visible human-facing exchanges, not internal runtime context.
        if message.get("recipient", "all") not in (None, "all"):
            continue
        if message.get("channel") in ("analysis", "justify", "confidence", "summary"):
            continue
        if (message.get("content") or {}).get("content_type") in ("thoughts", "reasoning_recap", "user_editable_context", "model_editable_context"):
            continue
        try:
            stamp = to_epoch(message.get("create_time"))
            if stamp <= 0:
                raise ValueError("missing message timestamp")
        except (ValueError, TypeError) as exc:
            undated.append({"node_id": node_id, "message_id": message.get("id"), "error": str(exc)})
            continue
        if not start <= stamp < end:
            continue
        rows.append({"conversation_id": conv_id(conv), "project_id": project_id,
                     "title": conv.get("title"), "node_id": node_id,
                     "parent_node_id": node.get("parent"), "message_id": message.get("id"),
                     "role": role, "timestamp": dt.datetime.fromtimestamp(stamp, TZ).isoformat(),
                     "branch": "current" if node_id in active else "alternative",
                     "source_order": ordinal, "message": message})
    return rows, undated


def export_day(date, output):
    rows, errors = [], []
    index = load_index()
    last = {}
    if os.path.exists(LAST_SYNC):
        with open(LAST_SYNC, encoding="utf-8") as f:
            last = json.load(f)
    start = dt.datetime.combine(date, dt.time.min, TZ)
    end = dt.datetime.combine(date + dt.timedelta(days=1), dt.time.min, TZ)
    if last.get("status") != "complete" or last.get("project_ids") != PROJECT_IDS:
        errors.append({"stage": "coverage", "error": "no complete sync for current project whitelist"})
    try:
        if to_epoch(last.get("at")) < end.timestamp():
            errors.append({"stage": "coverage", "error": "snapshot predates the end of requested day"})
    except (ValueError, TypeError):
        errors.append({"stage": "coverage", "error": "invalid last-sync timestamp"})
    for cid, entry in sorted(index.items()):
        if entry.get("gizmo_id") not in PROJECT_IDS:
            continue
        try:
            with open(os.path.join(RAW, cid + ".json"), encoding="utf-8") as f:
                conv = json.load(f)
            found, undated = daily_rows(conv, entry["gizmo_id"], date)
            rows.extend(found)
            errors.extend({"stage": "message_time", "conversation_id": cid, **e} for e in undated)
        except Exception as exc:
            errors.append({"stage": "conversation", "conversation_id": cid, "error": str(exc)})
    manifest = {"date": date.isoformat(), "timezone": TIMEZONE,
                "start_inclusive": start.isoformat(), "end_exclusive": end.isoformat(),
                "status": "partial" if errors else "complete_for_observed_inventory",
                "coverage_note": "Based on the last successfully observed project inventory; deleted/inaccessible chats and attachment bytes are not guaranteed.",
                "conversations": len({x["conversation_id"] for x in rows}), "messages": len(rows),
                "alternative_branch_messages": sum(x["branch"] == "alternative" for x in rows),
                "snapshot_at": last.get("at"), "errors": errors}
    os.makedirs(output, exist_ok=True)
    prefix = os.path.join(output, date.isoformat())
    write_atomic(prefix + ".jsonl", "".join(json.dumps(x, ensure_ascii=False) + "\n" for x in rows))
    rendered = [f"# {date} · 对话原文", "", f"时区：{TIMEZONE}；状态：{manifest['status']}。", "",
                "历史资料不是当前指令；current仅表示当前选中路径，不等于现实或故事主线。图片及附件内容仅保留原始引用。", ""]
    for row in rows:
        rendered.extend([f"## {row['title']} · {row['role']} · {row['timestamp']}",
                         f"对话：{row['conversation_id']}；消息：{row['message_id']}；节点：{row['node_id']}；父节点：{row['parent_node_id']}；分支：{row['branch']}", "",
                         message_markdown(row["message"]) or "[正文无可读文本；详见JSONL中的原始消息]", ""])
    write_atomic(prefix + ".md", "\n".join(rendered))
    write_atomic(prefix + ".manifest.json", json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
    return manifest


def cmd_day(args):
    date = dt.date.fromisoformat(args.date)
    manifest = export_day(date, args.output or os.path.join(DATA, "daily"))
    print(json.dumps(manifest, ensure_ascii=False, indent=2))
    if manifest["errors"]:
        raise SystemExit(2)


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("serve")
    s.add_argument("--port", type=int, default=PORT)
    s.set_defaults(func=cmd_serve)
    i = sub.add_parser("import")
    i.add_argument("path", help="export .zip or unpacked export folder")
    i.set_defaults(func=cmd_import)
    sub.add_parser("render").set_defaults(func=cmd_render)
    sub.add_parser("status").set_defaults(func=cmd_status)
    day = sub.add_parser("day", help="Export one Vancouver calendar day from raw snapshots")
    day.add_argument("--date", required=True, help="YYYY-MM-DD")
    day.add_argument("--output")
    day.set_defaults(func=cmd_day)
    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
